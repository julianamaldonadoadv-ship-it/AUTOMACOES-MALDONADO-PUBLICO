# =============================================================================
#  Maldonado Advogados - Variaveis de ambiente (TEMPLATE)
#  Copie este arquivo para  config/.env  e preencha com as credenciais DO
#  ESCRITORIO. NUNCA versione o .env real. Os valores comecam VAZIOS de proposito.
# =============================================================================

# -----------------------------------------------------------------------------
#  IDENTIDADE DO ESCRITORIO
# -----------------------------------------------------------------------------
ESCRITORIO_NOME=Maldonado Advogados
ESCRITORIO_ADVOGADO=Dr. Renan Gomes Maldonado de Jesus
ESCRITORIO_OAB=OAB/RO 5769
ESCRITORIO_ASSINATURA=Dr. Renan Gomes Maldonado de Jesus - OAB/RO 5769 - Porto Velho/RO
ESCRITORIO_CIDADE=Porto Velho - RO
CIDADE_FORO=Porto Velho
ESCRITORIO_ENDERECO=Rua Rafael Vaz e Silva, n. 1040, Bairro Nossa Senhora das Gracas, CEP 76.804-162, Porto Velho/RO
ESCRITORIO_TELEFONE=69 3223-5881
ESCRITORIO_EMAIL_RESPONSAVEL=maldonadoadvogadopvh@gmail.com

# -----------------------------------------------------------------------------
#  CREDENCIAIS / TOKENS  (preencher no onboarding)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ADVBOX_API_TOKEN=
# Conta Google DO ESCRITORIO Maldonado. O sistema recusa qualquer token que nao
# seja desta conta (evita gravar documento de cliente no Drive errado):
GOOGLE_CONTA_ESCRITORIO=
# Caminho do JSON de credenciais do Google Cloud (service account ou OAuth):
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json
GOOGLE_OAUTH_CREDENTIALS=config/oauth_credentials.json

# -----------------------------------------------------------------------------
#  GOOGLE DRIVE  - estrutura propria do escritorio (ZEUS)
#  Mantemos a convencao que o escritorio ja usa:
#  ZEUS > 03. CLIENTES > 01 CLIENTES > [LETRA] > [CLIENTE] > 4 subpastas
# -----------------------------------------------------------------------------
# Preencha PELO MENOS UM dos dois (o codigo usa CLIENTES_ID direto se existir;
# senao navega ZEUS > 03. CLIENTES > 01 CLIENTES). ID = ultimo trecho da URL da pasta.
DRIVE_PASTA_ZEUS_ID=
DRIVE_PASTA_CLIENTES_ID=
# Subpastas criadas dentro de cada cliente (separadas por virgula). Deixe vazio para
# usar o padrao do escritorio (CONTRATO BANCARIO, DOC ADMINISTRATIVO, DOC PESSOAL,
# REUNIOES - VIA MEET):
# Pasta de saida da automacao de peca: ZEUS > PEÇAS AUTOMAÇÃO > [CLIENTE] - [Nº PROCESSO]
# Opcional (caminho rapido, a prova de renomeacao). Sem isso o modulo localiza pelo nome na ZEUS.
DRIVE_PASTA_PECAS_AUTOMACAO_ID=

DRIVE_SUBPASTAS_CLIENTE=
# Timbrado isolado (so header/footer, sem conteudo de peca):
DOCS_MODELOS_TIMBRADO=DOCS_MODELOS/timbrado_modelo.docx
# Banco de teses (vault Obsidian) - Squad Jurimetria:
BASE_CONHECIMENTO_PATH=BASE_CONHECIMENTO/

# -----------------------------------------------------------------------------
#  USUARIOS ADVBOX  (IDs do painel ADVBOX > Usuarios - ver config/equipe.py)
# -----------------------------------------------------------------------------
ADVBOX_USER_RESPONSAVEL=
ADVBOX_USER_OUTRO_ADVOGADO=
ADVBOX_USER_GERENCIA_JURIDICA=
# Campo 'from' das tarefas /posts (quem assina a tarefa):
ADVBOX_USER_FROM=

# -----------------------------------------------------------------------------
#  DJEN/COMUNICA (CNJ)  - Squad Controladoria (prioridade)
# -----------------------------------------------------------------------------
# OABs monitoradas, separadas por virgula, formato NUMERO-UF (ex.: 5769-RO,13021-RO):
DJEN_OAB_LISTA=

# -----------------------------------------------------------------------------
#  AGENDA (Google Calendar) - eventos de prazo fatal
# -----------------------------------------------------------------------------
# E-mails da equipe que recebem convite de prazo, separados por virgula:
AGENDA_EMAILS_EQUIPE=

# -----------------------------------------------------------------------------
#  ATENDE DIREITO  - Squad Comercial/Intake (lead qualificado -> cliente ADVBOX)
#  A API nao tem doc publica: preencha base URL/token e, se o payload do
#  escritorio usar outros nomes, ajuste os endpoints e o mapa de campos abaixo.
#  Para descobrir os nomes reais:  python OPERACIONAL/main.py intake --inspecionar
# -----------------------------------------------------------------------------
ATENDE_DIREITO_BASE_URL=
ATENDE_DIREITO_API_TOKEN=
# Etapa/coluna do pipeline que significa "lead qualificado, pode virar cliente":
ATENDE_DIREITO_ETAPA_QUALIFICADO=

# Rotas (ajustar conforme a API real do Atende Direito):
ATENDE_DIREITO_ENDPOINT_LEADS=/leads
ATENDE_DIREITO_ENDPOINT_LEAD=/leads/{id}
# Rota de escrita para marcar o lead como ja integrado. Se ficar VAZIA, o modulo
# nao escreve nada no Atende Direito (a dedup fica por conta do CPF no ADVBOX):
ATENDE_DIREITO_ENDPOINT_MARCAR=
ATENDE_DIREITO_METODO_MARCAR=PATCH
ATENDE_DIREITO_CAMPO_MARCAR=stage
ATENDE_DIREITO_VALOR_MARCAR=INTEGRADO ADVBOX
ATENDE_DIREITO_CAMPO_OBSERVACAO=notes

# Nomes dos parametros de query (so mexer se a API usar outros):
ATENDE_DIREITO_PARAM_ETAPA=stage
ATENDE_DIREITO_PARAM_DATA_INICIO=start_date
ATENDE_DIREITO_PARAM_DATA_FIM=end_date
ATENDE_DIREITO_PARAM_LIMITE=limit
ATENDE_DIREITO_PARAM_PAGINA=page

# Overrides do mapa de campos, em JSON (destino -> campo no payload do lead).
# Ex.: {"cpf": "documento_cliente", "nome": "razao_social"}
ATENDE_DIREITO_MAPA_CAMPOS=

# Tipo de processo criado no ADVBOX para o lead que vira cliente:
ADVBOX_TIPO_PROCESSO_PADRAO=CIVEL

# -----------------------------------------------------------------------------
#  SYNC (Atende Direito)  - monitoramento processual: intimacoes, prazos, autos
#  NAO confundir com o bloco ATENDE_DIREITO_* acima, que e' o CRM/intake.
#  Sao dois produtos da mesma casa, com chave e base URL diferentes.
#
#  Doc oficial (Swagger publico): https://api.sync.atendedireito.app/openapi.json
#  Painel / gerar a chave:        https://sync.atendedireito.app  (aba API)
#  Diagnostico:                   python OPERACIONAL/main.py sync
# -----------------------------------------------------------------------------
# Chave da conta do escritorio, formato sk_live_... (vazio = integracao inativa,
# a triagem segue usando o DJEN normalmente):
SYNC_API_TOKEN=
# So mexer se a API mudar de endereco:
SYNC_BASE_URL=https://api.sync.atendedireito.app
SYNC_TIMEOUT=60

# TRAVA DE ESCRITA. Enquanto estiver vazio/0, o modulo do Sync e SOMENTE LEITURA:
# nao da ciencia em prazo, nao marca intimacao como tratada, nao cria monitor e
# nao registra webhook. Ligar so quando a Dra. Juliana autorizar - e mesmo ligado,
# cada gravacao continua exigindo confirmacao explicita.
SYNC_PERMITIR_ESCRITA=

# Segredo do HMAC-SHA256 que assina os webhooks (header X-Webhook-Signature).
# Sem ele, qualquer POST forjado na URL do receptor entra na fila da controller
# como se fosse intimacao do tribunal. Gerar com: openssl rand -hex 32
SYNC_WEBHOOK_SECRET=
# URL publica HTTPS que recebera os eventos (so necessaria quando o receptor
# estiver no ar; IP interno/privado e' recusado pela API do Sync):
SYNC_WEBHOOK_URL=

# -----------------------------------------------------------------------------
#  VPS (Hostinger) - onde as rotinas diarias rodam
#  Passo a passo completo: deploy/vps/README.md
# -----------------------------------------------------------------------------
# IP (ou hostname) da VPS, usuario de servico e caminho do projeto no servidor.
# Usado por  deploy/vps/enviar.sh  para enviar o codigo do Mac para a VPS.
VPS_HOST=
# Usuario de SERVICO: e' ele que roda a automacao (sem sudo, de proposito):
VPS_USUARIO=maldonado
# Usuario ADMINISTRATIVO: so para provisionar e instalar os timers. Na Hostinger
# a VPS nasce com acesso root; se voce criar outro admin, troque aqui.
VPS_USUARIO_ADMIN=root
VPS_CAMINHO=/opt/maldonado/automacoes
VPS_PORTA_SSH=22

# CHAVE DE AUTONOMIA DA ROTINA DE INTIMACOES.
# Vazio ou 0 = SIMULACAO: a rodada das 08:00 monta triagem, roteamento por
# controller, D-5/D-3, plano de tarefas e relatorio, e NAO grava nada no ADVBOX
# nem no Zeus. E' o padrao, e e' a semana de simulacao combinada com a
# Dra. Juliana: a automacao prova que acerta antes de ganhar autonomia.
# 1 = a rodada grava no ADVBOX. Mude SO no .env DA VPS, com a rodada conferida.
# (Protocolo continua sendo nunca - POP-CJ-PROT-001.)
VPS_ROTINA_GRAVAR=0
